-- 3. HÀM HỖ TRỢ QUY ĐỔI SỐ LUCK CÓ HẬU TỐ (T > B > M > K > Không đuôi)
local function parseLuckValue(luckStr)
	if not luckStr then return 0 end
	
	local numPart, suffix = luckStr:match("(%d+%.?%d*)%s*([TBMKtbmk]?)")
	local numberVal = tonumber(numPart) or 0
	
	if suffix then
		suffix = suffix:upper()
		if suffix == "T" then
			numberVal = numberVal * 1_000_000_000_000
		elseif suffix == "B" then
			numberVal = numberVal * 1_000_000_000
		elseif suffix == "M" then
			numberVal = numberVal * 1_000_000
		elseif suffix == "K" then
			numberVal = numberVal * 1_000
		end
	end
	
	return numberVal
end


-- 4. ĐỌC THÔNG TIN TRỨNG & LUCK
local function getEggInfo(egg)
	local rareInfo = "Common"
	if eggSpawnsFolder then
		local eggPos = Vector3.new(0,0,0)
		if egg:IsA("Model") then
			local primary = egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart")
			if primary then eggPos = primary.Position end
		elseif egg:IsA("BasePart") then
			eggPos = egg.Position
		end
		
		local shortestDistance = 15
		for _, spawnObj in ipairs(eggSpawnsFolder:GetChildren()) do
			local spawnPart = nil
			if spawnObj:IsA("Model") then
				spawnPart = spawnObj.PrimaryPart or spawnObj:FindFirstChildWhichIsA("BasePart")
			elseif spawnObj:IsA("BasePart") then
				spawnPart = spawnObj
			end
			
			if spawnPart then
				local dist = (spawnPart.Position - eggPos).Magnitude
				if dist < shortestDistance then
					shortestDistance = dist
					rareInfo = spawnObj.Name
				end
			end
		end
	end

	local luckValueNum = 0
	local luckValueStr = "0"
	
	local targetContainer = egg:FindFirstChild("Handle") or egg:FindFirstChild("RootPart")
	if targetContainer then
		local eggLuckFolder = targetContainer:FindFirstChild("EggLuck")
		if eggLuckFolder then
			local luckObj = eggLuckFolder:FindFirstChild("Luck")
			if luckObj and luckObj:IsA("TextLabel") then
				luckValueStr = luckObj.Text
				luckValueNum = parseLuckValue(luckValueStr)
			else
				for _, child in ipairs(eggLuckFolder:GetChildren()) do
					if child:IsA("TextLabel") and child.Text ~= "" then
						luckValueStr = child.Text
						luckValueNum = parseLuckValue(luckValueStr)
						break
					end
				end
			end
		end
	end

	return rareInfo, luckValueStr, luckValueNum
end


-- 5. HỆ THỐNG CACHE TRỨNG
local function initEggCache()
	activeEggsCache = {}
	if not renderedEggsFolder then return end
	
	for _, egg in ipairs(renderedEggsFolder:GetChildren()) do
		activeEggsCache[egg] = true
	end
	
	renderedEggsFolder.ChildAdded:Connect(function(egg)
		task.wait(0.05)
		activeEggsCache[egg] = true
	end)
	
	renderedEggsFolder.ChildRemoved:Connect(function(egg)
		activeEggsCache[egg] = nil
	end)
end

if renderedEggsFolder then
	initEggCache()
end


-- 6. ESP
local function createESP(egg)
	if activeESPs[egg] then return end
	if not egg:IsA("Model") and not egg:IsA("BasePart") then return end

	local rareInfo, luckValue = getEggInfo(egg)

	local highlight = Instance.new("Highlight")
	highlight.Name = "SmartHighlight"
	highlight.Adornee = egg
	highlight.FillColor = Color3.fromRGB(255, 215, 0)
	highlight.FillTransparency = 0.3
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineTransparency = 0
	highlight.Parent = egg

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "SmartBillboard"
	billboard.Size = UDim2.new(0, 180, 0, 45)
	billboard.StudsOffset = Vector3.new(0, 2.5, 0)
	billboard.AlwaysOnTop = true
	
	local adorneePart = egg
	if egg:IsA("Model") then
		adorneePart = egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart")
	end
	billboard.Adornee = adorneePart
	
	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.Text = "🥚 " .. egg.Name .. " [" .. rareInfo .. "]\nLuck: " .. luckValue
	textLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
	textLabel.TextStrokeTransparency = 0
	textLabel.TextSize = 11
	textLabel.Font = Enum.Font.GothamBold
	textLabel.Parent = billboard
	
	billboard.Parent = egg

	activeESPs[egg] = {
		Highlight = highlight,
		Billboard = billboard
	}
end

local function removeESP(egg)
	if activeESPs[egg] then
		if activeESPs[egg].Highlight then activeESPs[egg].Highlight:Destroy() end
		if activeESPs[egg].Billboard then activeESPs[egg].Billboard:Destroy() end
		activeESPs[egg] = nil
	end
end

local function enableESPFeature()
	if not renderedEggsFolder then return end
	
	for egg, _ in pairs(activeEggsCache) do
		createESP(egg)
	end
	
	local addConn = renderedEggsFolder.ChildAdded:Connect(function(egg)
		task.wait(0.1)
		if espEnabled then createESP(egg) end
	end)
	
	local removeConn = renderedEggsFolder.ChildRemoved:Connect(function(egg)
		removeESP(egg)
	end)
	
	table.insert(connections, addConn)
	table.insert(connections, removeConn)
end

local function disableESPFeature()
	for _, conn in ipairs(connections) do conn:Disconnect() end
	connections = {}
	for egg, _ in pairs(activeESPs) do removeESP(egg) end
end


-- 7. TÌM PLOT CHÍNH XÁC
local function getMyPlotPosition()
	local plotsFolder = Workspace:FindFirstChild("Plots")
	if not plotsFolder then return nil end
	
	for _, plotObj in ipairs(plotsFolder:GetChildren()) do
		local dataFolder = plotObj:FindFirstChild("Data")
		if dataFolder then
			local ownerVal = dataFolder:FindFirstChild("Owner")
			if ownerVal and (ownerVal.Value == LocalPlayer.Name or ownerVal.Value == LocalPlayer) then
				local primary = plotObj.PrimaryPart or plotObj:FindFirstChildWhichIsA("BasePart")
				if primary then
					return primary.Position + Vector3.new(0, 3, 0)
				end
			end
		end
	end
	return nil
end


-- 8. HÀM TWEEN & INSTANT PICKUP
local function tweenTo(targetCFrame)
	local char = getCharacter()
	if not char then return end
	local rootPart = char:FindFirstChild("HumanoidRootPart")
	if not rootPart then return end
	
	local distance = (rootPart.Position - targetCFrame.Position).Magnitude
	local speed = 1000
	local timeDuration = distance / speed
	if timeDuration < 0.02 then timeDuration = 0.02 end
	
	local tweenInfo = TweenInfo.new(timeDuration, Enum.EasingStyle.Linear)
	local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
	tween:Play()
	task.wait(timeDuration)
end

local function triggerPickup(egg)
	local prompt = egg:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt then
		pcall(function()
			if instantPickupEnabled then
				prompt.HoldDuration = 0
			end
			fireproximityprompt(prompt)
		end)
	else
		pcall(function()
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
			task.wait(0.02)
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
		end)
	end
end

local function startFly()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	if flyParts then return end
	
	local bodyGyro = Instance.new("BodyGyro", hrp)
	local bodyVelocity = Instance.new("BodyVelocity", hrp)
	bodyGyro.P = 9e4
	bodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
	bodyGyro.CFrame = hrp.CFrame
	bodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
	bodyVelocity.Velocity = Vector3.new(0, 0, 0)
	
	flyParts = { bodyGyro = bodyGyro, bodyVelocity = bodyVelocity, hrp = hrp }
	
	flyConnection = RunService.RenderStepped:Connect(function()
		if not flyParts then return end
		local h = flyParts.hrp
		if h and h.Parent then
			flyParts.bodyVelocity.Velocity = Vector3.new(0, 0, 0)
			flyParts.bodyGyro.CFrame = h.CFrame
		end
	end)
end

local function stopFly()
	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end
	if flyParts then
		if flyParts.bodyGyro then flyParts.bodyGyro:Destroy() end
		if flyParts.bodyVelocity then flyParts.bodyVelocity:Destroy() end
		flyParts = nil
	end
end


-- 9. AUTO FARM (CÓ MIN LUCK)
task.spawn(function()
	while true do
		task.wait(0.3)
		if autoFarmEnabled then
			local char = getCharacter()
			
			if char then
				local bestEgg = nil
				local bestWeight = -1
				local maxLuckVal = -1
				local bestEggIsVolcanic = false
				
				for egg, _ in pairs(activeEggsCache) do
					if egg and egg.Parent then
						local rareInfo, _, luckNum = getEggInfo(egg)
						
						if filterToggles[rareInfo] == true then
							-- MIN LUCK CHECK
							local passesMinLuck = true
							if minLuckEnabled and luckNum < minLuckValue then
								passesMinLuck = false
							end
							
							if passesMinLuck then
								local weight = rarityWeights[rareInfo] or 0
								
								if weight > bestWeight then
									bestWeight = weight
									maxLuckVal = luckNum
									bestEgg = egg
									bestEggIsVolcanic = (rareInfo == "Volcanic")
										or (egg.Name and egg.Name:lower():find("volcanic") ~= nil)
								elseif weight == bestWeight and luckNum > maxLuckVal then
									maxLuckVal = luckNum
									bestEgg = egg
									bestEggIsVolcanic = (rareInfo == "Volcanic")
										or (egg.Name and egg.Name:lower():find("volcanic") ~= nil)
								end
							end
						end
					else
						activeEggsCache[egg] = nil
					end
				end
				
				if bestEgg then
					local eggPart = nil
					if bestEgg:IsA("Model") then
						eggPart = bestEgg.PrimaryPart 
							or bestEgg:FindFirstChild("RootPart") 
							or bestEgg:FindFirstChildWhichIsA("BasePart")
					elseif bestEgg:IsA("BasePart") then
						eggPart = bestEgg
					end
					
					if eggPart then
						-- Nếu là Volcanic thì ghé trạm check trước
						if bestEggIsVolcanic then
							startFly()
							tweenTo(CFrame.new(-4791.6, 41285.4, -3849.6))
							tweenTo(CFrame.new(-4969.1, 41281.2, -3645.5))
							task.wait(1.0)
                            tweenTo(eggPart.CFrame + Vector3.new(0, 2, 0))
                        else
							startFly()
                            tweenTo(eggPart.CFrame + Vector3.new(0, 2, 0))
						end
												
						if bestEggIsVolcanic then
							task.wait(0.1)
						    triggerPickup(bestEgg)
							triggerPickup(bestEgg)
							triggerPickup(bestEgg)
						    task.wait(0.6)
                            tweenTo(CFrame.new(-4969.1, 41281.2, -3645.5))
							task.wait(0.3)
							tweenTo(CFrame.new(-4791.6, 41285.4, -3849.6))
							task.wait(0.6)
                        else
							task.wait(0.1)
                            triggerPickup(bestEgg)
							triggerPickup(bestEgg)
							triggerPickup(bestEgg)
						    task.wait(0.6)
						end
						
						-- BƯỚC 3: Tween về Plot
						local plotPos = getMyPlotPosition()
						if plotPos then
							tweenTo(CFrame.new(plotPos))
							stopFly()
							task.wait(0.4)
						end
					end
				end
			end
		end
	end
end)


