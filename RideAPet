		minLuckInput.Text = string.format("%.2fT", minLuckValue / 1_000_000_000_000)
	elseif minLuckValue >= 1_000_000_000 then
		minLuckInput.Text = string.format("%.2fB", minLuckValue / 1_000_000_000)
	elseif minLuckValue >= 1_000_000 then
		minLuckInput.Text = string.format("%.2fM", minLuckValue / 1_000_000)
